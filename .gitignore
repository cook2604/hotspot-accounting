# =============================================================================
#  Ignore rules for this repository.
#
#  This working copy doubles as a build machine: the self-contained toolchain (JDK, Gradle, Android
#  SDK) and all build output live under the same directory as the source. Everything of that kind is
#  excluded here, so only real source and documentation is ever committed.
#
#  Only ~500 KB of source is published; the ignored material is ~2.5 GB.
# =============================================================================

# --- Gradle / Android build output -------------------------------------------
build/
app/build/
.gradle/
.gradle-home/
.kotlin/
captures/
.cxx/

# --- Local machine configuration ---------------------------------------------
# Contains absolute SDK paths for this machine; regenerated by tools/build.ps1.
local.properties

# --- Android user home (debug keystore, SDK download cache) ------------------
.android-home/
.android/

# --- Temporary working directories -------------------------------------------
.tmp/
.probe/

# --- Self-contained build toolchain (downloaded, never committed) ------------
# The scripts in tools/ ARE committed; these downloaded payloads are not.
tools/jdk-17/
tools/gradle-8.14.5/
tools/android-sdk/
tools/cache/
tools/git/
tools/env.ps1

# --- Scratch files left in the working directory by unrelated tooling --------
# These are probe scripts/logs from other tools, not part of this project.
_*
!/.gitignore

# --- IDE / editor ------------------------------------------------------------
.idea/
*.iml
.vscode/
*.swp
*~

# --- OS noise ----------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs and crash dumps ----------------------------------------------------
*.log
hs_err_pid*

# --- GitHub credential handed over by the device-code flow (never committed) ---
tools/.gh-token
.gh-config/

# --- Defensive: never commit any credential file, wherever it lands -------------
*credentials*
*.gh-token
*.git-credentials
tools/gh/
tools/git/
